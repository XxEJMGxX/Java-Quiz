<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Separator?>
<?import javafx.geometry.Insets?>

<!--
    TIPOGRAFÍA — Golden Ratio (φ = 1.618) con base 8px:
        φ¹ = 13px  →  lblDetalle (desglose aciertos/errores)
        φ²  = 21px  →  lblNota y botones de acción
        φ³  = 34px  →  lblJugador (título de resultados)
-->
<VBox alignment="CENTER" spacing="25.0"
    xmlns="http://javafx.com/javafx/11"
    xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.javafx.TertiaryController"
    style="-fx-background-color: #1a1a2e;" prefWidth="800.0" prefHeight="600.0">

    <children>
        <!-- φ³ = 34px — Nombre del jugador y mensaje de fin -->
        <Label fx:id="lblJugador" text=""
            style="-fx-font-size: 34px; -fx-font-weight: bold; -fx-text-fill: white;" />

        <Separator style="-fx-background-color: #4040aa;" prefWidth="500.0" />

        <!-- φ² = 21px — Nota final -->
        <Label fx:id="lblNota" text=""
            style="-fx-font-size: 21px; -fx-text-fill: #ffd700; -fx-font-weight: bold;" />

        <!-- φ¹ = 13px — Desglose aciertos / errores -->
        <Label fx:id="lblDetalle" text="" style="-fx-font-size: 13px; -fx-text-fill: #a0a0c0;" />

        <Separator style="-fx-background-color: #4040aa;" prefWidth="500.0" />

        <!-- φ² = 21px — Botones de acción -->
        <HBox alignment="CENTER" spacing="20.0">
            <children>
                <Button text="Volver al menú" onAction="#volverAlMenu" prefWidth="190.0"
                    style="-fx-font-size: 21px; -fx-font-weight: bold; -fx-text-fill: white;
                               -fx-background-color: linear-gradient(from 100% 0% to 0% 100%, #1368CE, #7B2FBE);
                               -fx-background-radius: 8px; -fx-cursor: hand; -fx-padding: 10px 16px;" />
                <Button text="Salir" onAction="#salir" prefWidth="120.0"
                    style="-fx-font-size: 21px; -fx-font-weight: bold; -fx-text-fill: white;
                               -fx-background-color: linear-gradient(from 100% 0% to 0% 100%, #E21B3C, #E87722);
                               -fx-background-radius: 8px; -fx-cursor: hand; -fx-padding: 10px 16px;" />
            </children>
        </HBox>
    </children>

    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>
</VBox>